/-!
# `GlobalPhi43.noiseWindowSigma`

The noise σ-algebra `𝓕_{s,t}` of the window `(s,t]`.
-/

@[expose] public noncomputable section

open MeasureTheory Set
open scoped ENNReal

namespace GlobalPhi43

open RegularityStructures

variable {Ω : Type*} [MeasurableSpace Ω]

/-- The noise σ-algebra `𝓕_{s,t}` of the window `(s,t]`: generated by the
`P`-null sets and by the random variables `W(h)`, `h ∈ L²(ℝ × T³)` supported in `(s,t] × T³`. -/
@[instance_reducible]
def noiseWindowSigma (P : Measure Ω) (W : (SpaceTime → ℝ) → Ω → ℝ) (s t : ℝ) : MeasurableSpace Ω :=
  MeasurableSpace.generateFrom {A | MeasurableSet A ∧ P A = 0} ⊔
    ⨆ (h : SpaceTime → ℝ) (_ : MemLp h 2 ∧ Function.support h ⊆ Ioc s t ×ˢ univ),
      MeasurableSpace.comap (W h) inferInstance

end GlobalPhi43

end
