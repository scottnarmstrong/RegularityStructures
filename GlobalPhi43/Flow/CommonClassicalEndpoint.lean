module

public import GlobalPhi43.Flow.ClassicalWindowMeasurable

/-! Actual classical endpoints as common functionals of full smooth forcing.
The measurable structure used first is generated by evaluations; no growth
restriction, probability space or exceptional-set correction enters the map. -/

public noncomputable section

open MeasureTheory Set RegularityStructures RegularityStructures.Phi43

namespace GlobalPhi43.Flow

/-- The full smooth-forcing subtype, with its induced evaluation sigma algebra.
This is only a reducible alias; it introduces no alternative smooth topology. -/
abbrev SmoothForcing := {f : SpaceTime → ℝ // IsSmoothOnSpaceTime f}

/-- Measurability of a literal compact restriction follows from evaluations. -/
theorem smoothNoiseRestriction_measurable_of_evaluations {Ω : Type*} [MeasurableSpace Ω]
    (ξ : Ω → SpaceTime → ℝ) (hξ : ∀ ω, IsSmoothOnSpaceTime (ξ ω))
    (hm : ∀ z, Measurable fun ω => ξ ω z) (s T : ℝ) :
    Measurable (smoothNoiseRestriction ξ hξ s T) := by
  apply ContinuousMap.measurable_iff_eval.mpr
  intro z
  exact hm (s + z.1.1, z.2)

/-- The actual chosen endpoint is measurable from point evaluations alone.
The drift and external start are arbitrary; the elapsed horizon includes zero. -/
theorem smoothSolution_measurable_of_evaluations {η : NegExponent} {Ω : Type*} [MeasurableSpace Ω]
    (ξ : Ω → SpaceTime → ℝ) (hξ : ∀ ω, IsSmoothOnSpaceTime (ξ ω))
    (hm : ∀ z, Measurable fun ω => ξ ω z) (b s T : ℝ) (hT : 0 ≤ T)
    (x : C(Torus3, ℝ)) (hx : IsSmoothOnTorus x) :
    Measurable (fun ω => toHolderBesov η
      (smoothSolution b (shiftForcing s (ξ ω))
        (isSmoothOnSpaceTime_shiftForcing (hξ ω) s) x hx T)) := by
  apply (lipschitzWith_toHolderBesov η).continuous.measurable.comp
  exact classicalEndpoint_measurable_of_restriction ξ hξ b s T hT x _
    (fun ω => smoothSolution_spec b _ _ x hx)
    (smoothNoiseRestriction_measurable_of_evaluations ξ hξ hm s T)

/-- The common endpoint is defined before any noise space, at every smooth forcing. -/
@[expose] def commonClassicalEndpoint (η : NegExponent) (b s T : ℝ)
    (x : C(Torus3, ℝ)) (hx : IsSmoothOnTorus x) (f : SmoothForcing) : HolderBesov η :=
  toHolderBesov η (smoothSolution b (shiftForcing s f.val)
    (isSmoothOnSpaceTime_shiftForcing f.property s) x hx T)

theorem commonClassicalEndpoint_measurable (η : NegExponent) (b s T : ℝ) (hT : 0 ≤ T)
    (x : C(Torus3, ℝ)) (hx : IsSmoothOnTorus x) :
    Measurable (commonClassicalEndpoint η b s T x hx) :=
  smoothSolution_measurable_of_evaluations (η := η) Subtype.val (fun f => f.property)
    (fun z => (measurable_pi_apply z).comp measurable_subtype_coe) b s T hT x hx

/-- Actual nth endpoint on the whole smooth-noise sequence carrier. -/
@[expose] def sequenceClassicalEndpoint (η : NegExponent) (b : ℕ → ℝ)
    (n : ℕ) (s T : ℝ) (x : C(Torus3, ℝ)) (hx : IsSmoothOnTorus x)
    (f : ℕ → SmoothForcing) : HolderBesov η :=
  commonClassicalEndpoint η (b n) s T x hx (f n)

theorem sequenceClassicalEndpoint_measurable (η : NegExponent) (b : ℕ → ℝ)
    (n : ℕ) (s T : ℝ) (hT : 0 ≤ T) (x : C(Torus3, ℝ)) (hx : IsSmoothOnTorus x) :
    Measurable (sequenceClassicalEndpoint η b n s T x hx) :=
  (commonClassicalEndpoint_measurable η (b n) s T hT x hx).comp (measurable_pi_apply n)

end GlobalPhi43.Flow
