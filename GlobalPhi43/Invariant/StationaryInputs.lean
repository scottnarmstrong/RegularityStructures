module

public import GlobalPhi43.Invariant.WhiteNoiseProduct
public import GlobalPhi43.Invariant.FlowKernel
public import GlobalPhi43Statements.Defs.IsContinuousMeasurableFlow
public import GlobalPhi43.Flow.NoiseWindowRestriction

/-! # Adaptedness of Feller Markov flows and product-space independence -/

public noncomputable section

open MeasureTheory ProbabilityTheory RegularityStructures Set
open scoped NNReal

namespace GlobalPhi43.Invariant

/-- Independence of the initial coordinate and the sigma-algebra generated by the noise. -/
theorem noise_initial_indep_product {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω)
    [IsProbabilityMeasure P] {E : Type*} [MeasurableSpace E]
    (μ : Measure E) [IsProbabilityMeasure μ]
    (W : (SpaceTime → ℝ) → Ω → ℝ) (hW : IsWhiteNoise P W) :
    Indep (⨆ (h : SpaceTime → ℝ) (_ : MemLp h 2),
        MeasurableSpace.comap (fun q : Ω × E => W h q.1) inferInstance)
      (MeasurableSpace.comap (Prod.snd : Ω × E → E) inferInstance) (P.prod μ) := by
  have hi := (initial_indep_l2Noise_product P μ W hW).symm
  apply indep_of_indep_of_le hi _ le_rfl
  apply iSup_le
  intro h
  apply iSup_le
  intro hh
  have hm : @Measurable (Ω × E) ({h : SpaceTime → ℝ // MemLp h 2} → ℝ)
      (MeasurableSpace.comap (fun q : Ω × E =>
        fun h : {h : SpaceTime → ℝ // MemLp h 2} => W h.val q.1) inferInstance)
      inferInstance (fun q => fun h => W h.val q.1) := Measurable.of_comap_le le_rfl
  exact ((measurable_pi_apply (⟨h, hh⟩ : {h : SpaceTime → ℝ // MemLp h 2})).comp hm).comap_le

variable {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P]
    {η : NegExponent} (W : (SpaceTime → ℝ) → Ω → ℝ) (hW : IsWhiteNoise P W)
    {Ω₀ : Set Ω} (u : ℝ → ℝ → HolderBesov η → Ω → HolderBesov η)
    (hu : IsContinuousMeasurableFlow Ω₀ u) (h6 : IsFellerMarkovFlow P W u)

include hW hu h6

omit [IsProbabilityMeasure P] in
/-- The conditional Markov identity at elapsed time zero forces adaptedness of
the jointly measurable sample. The common null completion upgrades the conditional-expectation version. -/
theorem measurable_flow_noiseWindowSigma (s : ℝ≥0) (x : HolderBesov η) :
    Measurable[noiseWindowSigma P W 0 s] (u s 0 x) := by
  classical
  have hsamp : Measurable (u s 0 x) := by
    let ts : {r : ℝ × ℝ // 0 ≤ r.2 ∧ r.2 ≤ r.1} := ⟨(s, 0), le_rfl, s.property⟩
    exact hu.1.comp ((measurable_const (a := ts)).prodMk
      ((measurable_const (a := x)).prodMk measurable_id))
  intro A hA
  let g : HolderBesov η → ℝ := A.indicator (fun _ => 1)
  have hg : Measurable g := measurable_const.indicator hA
  have hb : ∀ y, |g y| ≤ 1 := by
    intro y
    by_cases hy : y ∈ A <;> simp [g, hy]
  have he := h6.2.2.2.2.1 g hg ⟨1, hb⟩ s 0 s.property le_rfl x
  have hz (y : HolderBesov η) : flowTransition P u 0 g y = g y := by
    rw [flowTransition, h6.2.2.1 y]
    exact integral_dirac' g y hg.stronglyMeasurable
  simp only [add_zero] at he
  simp_rw [hz] at he
  have hm : Measurable[noiseWindowSigma P W 0 s] (fun ω => g (u s 0 x ω)) :=
    Flow.measurable_of_ae_eq_of_null_le P (Markov.noiseWindowSigma_le P hW 0 s)
      le_sup_left (hg.comp hsamp) stronglyMeasurable_condExp.measurable he.symm
  have heq : (fun ω => g (u s 0 x ω)) ⁻¹' ({1} : Set ℝ) = (u s 0 x) ⁻¹' A := by
    ext ω
    by_cases h : u s 0 x ω ∈ A <;> simp [g, h]
  exact heq ▸ hm (measurableSet_singleton 1)

end GlobalPhi43.Invariant
