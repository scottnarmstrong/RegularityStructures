module

public import GlobalPhi43.Probability.WhiteNoiseL2Continuity
public import GlobalPhi43.Markov.WhiteNoiseIndependence
public import GlobalPhi43.Markov.Independence

/-! Completed information fields generated by L2 tests supported in a set.
The null generator is the ambient one, independent of the support set. -/

public noncomputable section

open MeasureTheory ProbabilityTheory Set RegularityStructures

namespace GlobalPhi43.Probability

abbrev SupportedTest (S : Set SpaceTime) :=
  {h : SpaceTime → ℝ // MemLp h 2 ∧ Function.support h ⊆ S}

@[expose, instance_reducible] def supportedNoiseSigma {Ω : Type*} [mΩ : MeasurableSpace Ω]
    (P : Measure Ω) (W : (SpaceTime → ℝ) → Ω → ℝ) (S : Set SpaceTime) : MeasurableSpace Ω :=
  MeasurableSpace.generateFrom {A | MeasurableSet[mΩ] A ∧ P A = 0} ⊔
    ⨆ (h : SpaceTime → ℝ) (_ : MemLp h 2 ∧ Function.support h ⊆ S),
      MeasurableSpace.comap (W h) inferInstance

theorem supportedNoiseSigma_le {Ω : Type*} [mΩ : MeasurableSpace Ω] (P : Measure Ω)
    {W : (SpaceTime → ℝ) → Ω → ℝ} (hW : IsWhiteNoise P W) (S : Set SpaceTime) :
    supportedNoiseSigma P W S ≤ mΩ := by
  apply sup_le
  · exact MeasurableSpace.generateFrom_le fun _ h => h.1
  · exact iSup_le fun h => iSup_le fun hh => (hW.1 h hh.1).comap_le

theorem null_le_supportedNoiseSigma {Ω : Type*} [mΩ : MeasurableSpace Ω] (P : Measure Ω)
    (W : (SpaceTime → ℝ) → Ω → ℝ) (S : Set SpaceTime) :
    MeasurableSpace.generateFrom {A | MeasurableSet[mΩ] A ∧ P A = 0} ≤
      supportedNoiseSigma P W S := le_sup_left

theorem supportedNoiseSigma_mono {Ω : Type*} [mΩ : MeasurableSpace Ω] (P : Measure Ω)
    (W : (SpaceTime → ℝ) → Ω → ℝ) {S T : Set SpaceTime} (hST : S ⊆ T) :
    supportedNoiseSigma P W S ≤ supportedNoiseSigma P W T := by
  apply sup_le_sup le_rfl
  exact iSup_le fun h => iSup_le fun hh =>
    le_iSup_of_le h (le_iSup_of_le ⟨hh.1, hh.2.trans hST⟩ le_rfl)

theorem measurable_supported_pairing {Ω : Type*} [mΩ : MeasurableSpace Ω] (P : Measure Ω)
    (W : (SpaceTime → ℝ) → Ω → ℝ) {S : Set SpaceTime}
    {h : SpaceTime → ℝ} (hh : MemLp h 2) (hs : Function.support h ⊆ S) :
    Measurable[supportedNoiseSigma P W S] (W h) :=
  Measurable.of_comap_le (le_sup_of_le_right
    (le_iSup_of_le h (le_iSup_of_le ⟨hh, hs⟩ le_rfl)))

theorem supportedNoiseSigma_eq_process {Ω : Type*} [mΩ : MeasurableSpace Ω] (P : Measure Ω)
    (W : (SpaceTime → ℝ) → Ω → ℝ) (S : Set SpaceTime) :
    supportedNoiseSigma P W S =
      MeasurableSpace.generateFrom {A | MeasurableSet[mΩ] A ∧ P A = 0} ⊔
      MeasurableSpace.comap (fun ω (h : SupportedTest S) => W h.val ω) inferInstance := by
  apply congrArg (fun m => MeasurableSpace.generateFrom
    {A | MeasurableSet[mΩ] A ∧ P A = 0} ⊔ m)
  apply le_antisymm
  · apply iSup_le
    intro h
    apply iSup_le
    intro hh
    have hp : @Measurable Ω (SupportedTest S → ℝ)
        (MeasurableSpace.comap (fun ω (g : SupportedTest S) => W g.val ω) inferInstance)
        inferInstance (fun ω (g : SupportedTest S) => W g.val ω) :=
      Measurable.of_comap_le le_rfl
    exact ((measurable_pi_apply (⟨h, hh⟩ : SupportedTest S)).comp hp).comap_le
  · let m := ⨆ (h : SpaceTime → ℝ) (_ : MemLp h 2 ∧ Function.support h ⊆ S),
        MeasurableSpace.comap (W h) inferInstance
    have hp : @Measurable Ω (SupportedTest S → ℝ) m inferInstance
        (fun ω (h : SupportedTest S) => W h.val ω) := by
      apply measurable_pi_iff.mpr
      intro h
      exact Measurable.of_comap_le (le_iSup_of_le h.val (le_iSup_of_le h.property le_rfl))
    exact hp.comap_le

theorem indep_supportedNoiseSigma {Ω : Type*} [mΩ : MeasurableSpace Ω] (P : Measure Ω)
    {W : (SpaceTime → ℝ) → Ω → ℝ} (hW : IsWhiteNoise P W)
    {S T : Set SpaceTime} (hST : Disjoint S T) :
    Indep (supportedNoiseSigma P W S) (supportedNoiseSigma P W T) P := by
  have horth (h : SupportedTest S) (g : SupportedTest T) : (∫ z, h.val z * g.val z) = 0 := by
    apply integral_eq_zero_of_ae
    apply ae_of_all
    intro z
    change h.val z * g.val z = 0
    by_cases hz : h.val z = 0
    · rw [hz, zero_mul]
    · have hg : g.val z = 0 := by
        by_contra hg
        exact Set.disjoint_left.mp hST
          (h.property.2 (Function.mem_support.mpr hz))
          (g.property.2 (Function.mem_support.mpr hg))
      rw [hg, mul_zero]
  have hi := Markov.whiteNoise_indep_processes P hW
    (fun h : SupportedTest S => h.val) (fun g : SupportedTest T => g.val)
    (fun h => h.property.1) (fun g => g.property.1) horth
  rw [supportedNoiseSigma_eq_process, supportedNoiseSigma_eq_process]
  exact Markov.indep_adjoin_null P hi

end GlobalPhi43.Probability
