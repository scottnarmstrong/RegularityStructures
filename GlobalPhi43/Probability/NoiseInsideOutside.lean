module

public import GlobalPhi43.Probability.SupportedNoiseSigma

/-! Each actual white-noise test splits into its inside and outside pieces.
Only this completed whole-noise field, not the ambient field with possible
extra randomness, is generated by the two complementary information fields. -/

public noncomputable section

open MeasureTheory ProbabilityTheory Set RegularityStructures

namespace GlobalPhi43.Probability

theorem support_indicator_subset (S : Set SpaceTime) (h : SpaceTime → ℝ) :
    Function.support (S.indicator h) ⊆ S := by
  intro z hz
  by_contra hmem
  exact hz (Set.indicator_of_notMem hmem h)

theorem supportedNoiseSigma_le_split {Ω : Type*} [mΩ : MeasurableSpace Ω]
    (P : Measure Ω) {W : (SpaceTime → ℝ) → Ω → ℝ} (hW : IsWhiteNoise P W)
    (I : Set SpaceTime) (hI : MeasurableSet I) (S : Set SpaceTime) :
    supportedNoiseSigma P W S ≤ supportedNoiseSigma P W I ⊔ supportedNoiseSigma P W Iᶜ := by
  let m := supportedNoiseSigma P W I ⊔ supportedNoiseSigma P W Iᶜ
  have hm : m ≤ mΩ := sup_le (supportedNoiseSigma_le (mΩ := mΩ) P hW I)
    (supportedNoiseSigma_le (mΩ := mΩ) P hW Iᶜ)
  have hn : MeasurableSpace.generateFrom {A | MeasurableSet[mΩ] A ∧ P A = 0} ≤ m :=
    (null_le_supportedNoiseSigma (mΩ := mΩ) P W I).trans le_sup_left
  apply sup_le hn
  apply iSup_le
  intro h
  apply iSup_le
  intro hh
  have hi := hh.1.indicator hI
  have ho := hh.1.indicator hI.compl
  have hmi : Measurable[m] (W (I.indicator h)) :=
    (measurable_supported_pairing (mΩ := mΩ) P W hi (support_indicator_subset I h)).mono
      le_sup_left le_rfl
  have hmo : Measurable[m] (W (Iᶜ.indicator h)) :=
    (measurable_supported_pairing (mΩ := mΩ) P W ho (support_indicator_subset Iᶜ h)).mono
      le_sup_right le_rfl
  have hsplit : I.indicator h + Iᶜ.indicator h = h := by
    funext z
    by_cases hz : z ∈ I <;> simp [hz]
  have he := @whiteNoise_add_ae_fun Ω mΩ P W hW (I.indicator h) (Iᶜ.indicator h) hi ho
  rw [hsplit] at he
  exact (Flow.measurable_of_ae_eq_of_null_le (mΩ := mΩ) P hm hn (hW.1 h hh.1)
    (hmi.add hmo) he).comap_le

end GlobalPhi43.Probability
