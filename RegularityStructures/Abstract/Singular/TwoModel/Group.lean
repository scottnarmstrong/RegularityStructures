module

public import RegularityStructures.Abstract.Singular.TwoModel.Gamma

/-!
# The model-independent structure `𝒯⊕` of the difference model

The structure group of `𝒯⊕` (on `ι⊕ = ι₀ ⊕ ι`) must not depend on the models `M₁, M₂`, since the
constant of the single-model Theorem 7.1 is chosen after fixing the structure. We take the group
generated by all block maps
`blockGen P g g' c = (a, b) ↦ (Q g E₀ a, c (g - g') E₀ a + g' b)`
with `g, g'` in the structure group of `𝒯` agreeing on `P.subspace` and `c : ℝ`
(`genSetSum`, `groupSumU`). Every `Γ⊕_{xy}` is such a generator (`gammaSum_eq_blockGen`).

* `structSumU P`: the regularity structure `𝒯⊕` (graded unipotence on generators, then closure);
* `polySectorSum P`: the polynomial sector `P⊕` with `emb = inr ∘ P.emb`; invariance because
  generators preserve `polySubspaceSum P` and (finite dimension) so do their inverses.
-/

@[expose] public noncomputable section

namespace RegularityStructures

namespace TwoModel

variable {ι : Type*} [Fintype ι] [DecidableEq ι] {𝒯 : RegularityStructure ι} {N' : ℕ}
  (P : PolynomialSector 𝒯 N')

/-- The block map `(a, b) ↦ (Q g E₀ a, c (g - g') E₀ a + g' b)`. -/
def blockGen (g g' : (ι → ℝ) →ₗ[ℝ] (ι → ℝ)) (c : ℝ) :
    (NonPoly P ⊕ ι → ℝ) →ₗ[ℝ] (NonPoly P ⊕ ι → ℝ) :=
  blockMap P (restrictNP P ∘ₗ g ∘ₗ extendNP P) (c • ((g - g') ∘ₗ extendNP P)) g'

/-- The generators of the structure group of `𝒯⊕`. -/
def genSetSum : Set (LinearMap.GeneralLinearGroup ℝ (NonPoly P ⊕ ι → ℝ)) :=
  {u | ∃ g ∈ 𝒯.group, ∃ g' ∈ 𝒯.group,
    (∀ p ∈ P.subspace, ((g : LinearMap.GeneralLinearGroup ℝ (ι → ℝ)) : (ι → ℝ) →ₗ[ℝ] (ι → ℝ)) p =
      ((g' : LinearMap.GeneralLinearGroup ℝ (ι → ℝ)) : (ι → ℝ) →ₗ[ℝ] (ι → ℝ)) p) ∧
    ∃ c : ℝ, ((u : LinearMap.GeneralLinearGroup ℝ (NonPoly P ⊕ ι → ℝ)) :
      (NonPoly P ⊕ ι → ℝ) →ₗ[ℝ] (NonPoly P ⊕ ι → ℝ)) =
      blockGen P (g : (ι → ℝ) →ₗ[ℝ] (ι → ℝ)) (g' : (ι → ℝ) →ₗ[ℝ] (ι → ℝ)) c}

/-- The structure group of `𝒯⊕`: generated by `genSetSum P`. -/
def groupSumU : Subgroup (LinearMap.GeneralLinearGroup ℝ (NonPoly P ⊕ ι → ℝ)) :=
  Subgroup.closure (genSetSum P)

/-- The span of the vectors of `ι⊕ → ℝ` supported on `inr '' range P.emb`. -/
def polySubspaceSum : Submodule ℝ (NonPoly P ⊕ ι → ℝ) where
  carrier := {τ | ∀ s, s ∉ Set.range (fun k => (Sum.inr (P.emb k) : NonPoly P ⊕ ι)) → τ s = 0}
  add_mem' {τ σ} hτ hσ s hs := by simp [hτ s hs, hσ s hs]
  zero_mem' _ _ := rfl
  smul_mem' c τ hτ s hs := by simp [hτ s hs]

/-- The subgroup of `GL(W)` preserving `V` together with its inverses. -/
def stabilizerGroup {W : Type*} [AddCommGroup W] [Module ℝ W] (V : Submodule ℝ W) :
    Subgroup (LinearMap.GeneralLinearGroup ℝ W) where
  carrier := {g | ∀ v ∈ V, (g : W →ₗ[ℝ] W) v ∈ V ∧ ((g⁻¹ : LinearMap.GeneralLinearGroup ℝ W) :
    W →ₗ[ℝ] W) v ∈ V}
  mul_mem' {g h} hg hh v hv := by
    refine ⟨?_, ?_⟩
    · have := (hg _ (hh v hv).1).1
      simpa using this
    · have := (hh _ (hg v hv).2).2
      simpa using this
  one_mem' v hv := ⟨by simpa using hv, by simpa using hv⟩
  inv_mem' {g} hg v hv := by
    refine ⟨(hg v hv).2, ?_⟩
    simpa using (hg v hv).1

end TwoModel

end RegularityStructures

end

public section

namespace RegularityStructures

namespace TwoModel

variable {ι : Type*} [Fintype ι] [DecidableEq ι] {𝒯 : RegularityStructure ι} {N' : ℕ}
  (P : PolynomialSector 𝒯 N')

/-- In finite dimension, an invertible map preserving a subspace has inverse preserving it. -/
theorem inv_apply_mem_of_forall_mem {W : Type*} [AddCommGroup W] [Module ℝ W]
    [FiniteDimensional ℝ W] (V : Submodule ℝ W) (u : LinearMap.GeneralLinearGroup ℝ W)
    (h : ∀ v ∈ V, (u : W →ₗ[ℝ] W) v ∈ V) :
    ∀ v ∈ V, ((u⁻¹ : LinearMap.GeneralLinearGroup ℝ W) : W →ₗ[ℝ] W) v ∈ V := by
  have hinv : ∀ w, ((u⁻¹ : LinearMap.GeneralLinearGroup ℝ W) : W →ₗ[ℝ] W)
      ((u : W →ₗ[ℝ] W) w) = w := fun w => by
    rw [← Module.End.mul_apply, Units.inv_mul, Module.End.one_apply]
  intro v hv
  set gr := (u : W →ₗ[ℝ] W).restrict (p := V) (q := V) h
  have hinj : Function.Injective gr := by
    intro a b hab
    apply Subtype.ext
    have := congrArg Subtype.val hab
    simp only [gr, LinearMap.coe_restrict_apply] at this
    rw [← hinv a, ← hinv b, this]
  obtain ⟨w, hw⟩ := (LinearMap.injective_iff_surjective.1 hinj) ⟨v, hv⟩
  have hw' : (u : W →ₗ[ℝ] W) w = v := by
    have := congrArg Subtype.val hw
    simpa [gr] using this
  rw [← hw', hinv]
  exact w.2

theorem mem_stabilizerGroup_of_forall_mem {W : Type*} [AddCommGroup W] [Module ℝ W]
    [FiniteDimensional ℝ W] (V : Submodule ℝ W) (u : LinearMap.GeneralLinearGroup ℝ W)
    (h : ∀ v ∈ V, (u : W →ₗ[ℝ] W) v ∈ V) : u ∈ stabilizerGroup V :=
  fun v hv => ⟨h v hv, inv_apply_mem_of_forall_mem V u h v hv⟩

@[simp] theorem blockGen_apply_inl (g g' : (ι → ℝ) →ₗ[ℝ] (ι → ℝ)) (c : ℝ)
    (v : NonPoly P ⊕ ι → ℝ) (i : NonPoly P) :
    blockGen P g g' c v (Sum.inl i) = g (extendNP P (leftPart P v)) i.1 := rfl

@[simp] theorem blockGen_apply_inr (g g' : (ι → ℝ) →ₗ[ℝ] (ι → ℝ)) (c : ℝ)
    (v : NonPoly P ⊕ ι → ℝ) (j : ι) :
    blockGen P g g' c v (Sum.inr j) =
      c * (g (extendNP P (leftPart P v)) j - g' (extendNP P (leftPart P v)) j) +
        g' (rightPart P v) j := rfl

theorem blockGen_pairVec (g g' : (ι → ℝ) →ₗ[ℝ] (ι → ℝ)) (c : ℝ) (a : NonPoly P → ℝ) (b : ι → ℝ) :
    blockGen P g g' c (pairVec P a b) =
      pairVec P (restrictNP P (g (extendNP P a)))
        (c • (g (extendNP P a) - g' (extendNP P a)) + g' b) := rfl

theorem extendNP_single (i : NonPoly P) : extendNP P (Pi.single i 1) = Pi.single i.1 1 := by
  funext k
  by_cases hk : k ∈ Set.range P.emb
  · rw [extendNP_apply_of_mem P _ hk]
    have : k ≠ i.1 := fun h => i.2 (h ▸ hk)
    simp [this]
  · rw [extendNP_apply_of_notMem P _ hk]
    simp [Pi.single_apply, Subtype.ext_iff]

theorem single_inl (i : NonPoly P) :
    (Pi.single (Sum.inl i) 1 : NonPoly P ⊕ ι → ℝ) = pairVec P (Pi.single i 1) 0 := by
  funext s
  rcases s with j | j <;> simp [Pi.single_apply]

theorem single_inr (i : ι) :
    (Pi.single (Sum.inr i) 1 : NonPoly P ⊕ ι → ℝ) = pairVec P 0 (Pi.single i 1) := by
  funext s
  rcases s with j | j <;> simp [Pi.single_apply]

theorem isGradedUnipotent_blockGen {g g' : (ι → ℝ) →ₗ[ℝ] (ι → ℝ)}
    (hg : IsGradedUnipotent 𝒯.deg g) (hg' : IsGradedUnipotent 𝒯.deg g') (c : ℝ) :
    IsGradedUnipotent (degSum P) (blockGen P g g' c) := by
  intro s
  rcases s with i | i
  · intro r hr
    rcases r with j | j
    · have h := hg i.1 j.1 (by simpa using hr)
      simp only [Pi.sub_apply, Pi.single_apply] at h
      simp [single_inl, blockGen_pairVec, extendNP_single, Pi.single_apply, Subtype.ext_iff, h]
    · have h := hg i.1 j (by simpa using hr)
      have h' := hg' i.1 j (by simpa using hr)
      simp only [Pi.sub_apply, Pi.single_apply] at h h'
      simp [single_inl, blockGen_pairVec, extendNP_single]
      right
      linarith
  · intro r hr
    rcases r with j | j
    · simp [single_inr, blockGen_pairVec]
    · have h := hg' i j (by simpa using hr)
      simp only [Pi.sub_apply, Pi.single_apply] at h
      simp [single_inr, blockGen_pairVec, Pi.single_apply, h]

theorem blockGen_mem_polySubspaceSum {g g' : (ι → ℝ) →ₗ[ℝ] (ι → ℝ)}
    (hg' : ∀ p ∈ P.subspace, g' p ∈ P.subspace) (c : ℝ) {v : NonPoly P ⊕ ι → ℝ}
    (hv : v ∈ polySubspaceSum P) : blockGen P g g' c v ∈ polySubspaceSum P := by
  have hl : leftPart P v = 0 := by
    funext i
    exact hv (Sum.inl i) (by simp)
  have hr : rightPart P v ∈ P.subspace := fun j hj =>
    hv (Sum.inr j) (by
      rintro ⟨k, hk⟩
      exact hj ⟨k, Sum.inr_injective hk⟩)
  intro s hs
  rcases s with i | j
  · rw [blockGen_apply_inl, hl]
    simp
  · rw [blockGen_apply_inr, hl]
    have hj : j ∉ Set.range P.emb := fun ⟨k, hk⟩ => hs ⟨k, by simp [hk]⟩
    have h2 : g' (rightPart P v) j = 0 := hg' _ hr j hj
    simp [h2]

theorem groupSumU_le_stabilizerGroup : groupSumU P ≤ stabilizerGroup (polySubspaceSum P) := by
  refine Subgroup.closure_le _ |>.2 ?_
  rintro u ⟨g, hg, g', hg', -, c, hu⟩
  refine mem_stabilizerGroup_of_forall_mem _ u fun v hv => ?_
  rw [hu]
  exact blockGen_mem_polySubspaceSum P (fun p hp => fun j hj =>
    P.invariant g' hg' p hp j hj) c hv

theorem isGradedUnipotent_of_mem_groupSumU {u : LinearMap.GeneralLinearGroup ℝ (NonPoly P ⊕ ι → ℝ)}
    (hu : u ∈ groupSumU P) :
    IsGradedUnipotent (degSum P) (u : (NonPoly P ⊕ ι → ℝ) →ₗ[ℝ] (NonPoly P ⊕ ι → ℝ)) := by
  induction hu using Subgroup.closure_induction with
  | mem u hu =>
    obtain ⟨g, hg, g', hg', -, c, hu⟩ := hu
    rw [hu]
    exact isGradedUnipotent_blockGen P (𝒯.isGradedUnipotent g hg) (𝒯.isGradedUnipotent g' hg') c
  | one => exact isGradedUnipotent_id
  | mul g h _ _ hg hh =>
    change IsGradedUnipotent (degSum P)
      ((g : (NonPoly P ⊕ ι → ℝ) →ₗ[ℝ] (NonPoly P ⊕ ι → ℝ)) *
        (h : (NonPoly P ⊕ ι → ℝ) →ₗ[ℝ] (NonPoly P ⊕ ι → ℝ)))
    rw [Module.End.mul_eq_comp]
    exact hg.comp hh
  | inv g _ hg => exact hg.inv

/-- The regularity structure `𝒯⊕` on `ι⊕ = ι₀ ⊕ ι`, depending only on `𝒯` and `P`
(the structure of the difference model). -/
@[expose] def structSumU : RegularityStructure (NonPoly P ⊕ ι) where
  deg := degSum P
  group := groupSumU P
  isGradedUnipotent _ hg := isGradedUnipotent_of_mem_groupSumU P hg

/-- The polynomial sector `P⊕` of `𝒯⊕`: `emb = inr ∘ P.emb`. -/
@[expose] def polySectorSum : PolynomialSector (structSumU P) N' where
  emb k := Sum.inr (P.emb k)
  emb_injective _ _ h := P.emb_injective (Sum.inr_injective h)
  deg_emb k := P.deg_emb k
  invariant _ hg τ hτ s hs :=
    (groupSumU_le_stabilizerGroup P hg τ hτ).1 s hs

end TwoModel

end RegularityStructures

end
