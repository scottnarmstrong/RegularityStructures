/-!
# The finite Φ⁴₃ symbol sector

This is the finite part of Hairer's structure for the dynamical Φ⁴₃ equation
which is needed by the fixed point and by the two counterterms.  The source is
Hairer, *A theory of regularity structures*, arXiv:1303.5113v4 (`Hai14`).
The construction follows §8.1 and the concrete choice (9.2).  The positive
symbol `I(Ψ)` is retained because it occurs in Hairer's renormalisation table
(9.3), even though it is above the fixed-point cutoff.  We use
`α = -5/2-κ`, `κ ∈ (0,1/16)`, and `γ = 1+3κ` as in §9.4.

The symbols `XᵢΨ`, `XᵢXⱼ`, and `XᵢΨ²` are retained in the finite product
table.  The first and third occur in the Taylor expansion of the products
`I(Ψ)Ψ` and `I(Ψ)Ψ²`; the second is the polynomial product required for the
structure-group action.  `X₀` is included with parabolic degree two, although
it lies above this cutoff.
-/

@[expose] public noncomputable section

open Set

namespace RegularityStructures.Phi43

/-- The admissible noise parameter, corresponding to Hairer §9.2. -/
abbrev Kappa : Type := Ioo (0 : ℝ) (1 / 16)

/-- The upper endpoint of this project's parameter interval `κ ∈ (0,1/16)`.

After writing `α = -5/2 - κ`, this is a strict subinterval of the range
`α ∈ (-18/7,-5/2)` stated in Hairer §9.2; the fixed-point cutoff is checked
in §9.4. -/
def kappa₀ : ℝ := 1 / 16

/-- The finite inductive symbol set used by the product sector.

The positive symbol `I(Ψ)` is needed by Hairer's renormalisation map. -/
inductive Symbol where
  | one
  | noise
  | x0
  | x (i : Fin 3)
  | xMul (p : Sym2 (Fin 3))
  | psi
  | iPsi
  | psiSq
  | psiCube
  | psiX (i : Fin 3)
  | psiSqX (i : Fin 3)
  | iPsiSq
  | iPsiCube
  | iPsiPsi
  | iPsiPsiSq
  | iPsiSqPsi
  | iPsiSqPsiSq
  | iPsiCubePsi
  | iPsiCubePsiSq
  | iPsiCubeSq
  deriving DecidableEq, Fintype

/-- The homogeneity assignment from Hairer §8.1.

Here `Ψ = I(Ξ)`, `|Ξ| = -5/2-κ`, `|X₀|=2`, and `|Xᵢ|=1`. -/
def homogeneity (κ : Kappa) : Symbol → ℝ
  | .one => 0
  | .noise => -5 / 2 - κ.1
  | .x0 => 2
  | .x _ => 1
  | .xMul _ => 2
  | .psi => -1 / 2 - κ.1
  | .iPsi => 3 / 2 - κ.1
  | .psiSq => -1 - 2 * κ.1
  | .psiCube => -3 / 2 - 3 * κ.1
  | .psiX _ => 1 / 2 - κ.1
  | .psiSqX _ => -2 * κ.1
  | .iPsiSq => 1 - 2 * κ.1
  | .iPsiCube => 1 / 2 - 3 * κ.1
  | .iPsiPsi => 1 - 2 * κ.1
  | .iPsiPsiSq => 1 / 2 - 3 * κ.1
  | .iPsiSqPsi => 1 / 2 - 3 * κ.1
  | .iPsiSqPsiSq => -4 * κ.1
  | .iPsiCubePsi => -4 * κ.1
  | .iPsiCubePsiSq => -1 / 2 - 5 * κ.1
  | .iPsiCubeSq => 1 - 6 * κ.1

/-- Hairer's fixed-point cutoff, chosen just above the required threshold. -/
def gamma (κ : Kappa) : ℝ := 1 + 3 * κ.1

theorem kappa_pos (κ : Kappa) : 0 < κ.1 := κ.2.1

theorem kappa_lt_kappa₀ (κ : Kappa) : κ.1 < kappa₀ := by
  simpa [kappa₀] using κ.2.2

theorem gamma_lt_iPsi (κ : Kappa) : gamma κ < 3 / 2 - κ.1 := by
  have hk₀ : κ.1 < 1 / 16 := kappa_lt_kappa₀ κ
  dsimp [gamma]
  linarith

/-- The finite product table generated by Hairer's rules.

An absent entry is the zero product in the finite truncation, as in the last
sentence of Hairer's discussion following (8.4). -/
def productSymbol : Symbol → Symbol → Option Symbol
  | .one, b => some b
  | a, .one => some a
  | .x i, .x j => some (.xMul s(i, j))
  | .x j, .psi => some (.psiX j)
  | .psi, .x j => some (.psiX j)
  | .x j, .psiSq => some (.psiSqX j)
  | .psiSq, .x j => some (.psiSqX j)
  | .psi, .psi => some .psiSq
  | .psi, .psiSq => some .psiCube
  | .psiSq, .psi => some .psiCube
  | .psiX i, .psi => some (.psiSqX i)
  | .psi, .psiX i => some (.psiSqX i)
  | .iPsi, .psi => some .iPsiPsi
  | .psi, .iPsi => some .iPsiPsi
  | .iPsi, .psiSq => some .iPsiPsiSq
  | .psiSq, .iPsi => some .iPsiPsiSq
  | .iPsiPsi, .psi => some .iPsiPsiSq
  | .psi, .iPsiPsi => some .iPsiPsiSq
  | .iPsiSq, .psi => some .iPsiSqPsi
  | .psi, .iPsiSq => some .iPsiSqPsi
  | .iPsiCube, .psi => some .iPsiCubePsi
  | .psi, .iPsiCube => some .iPsiCubePsi
  | .iPsiSq, .psiSq => some .iPsiSqPsiSq
  | .psiSq, .iPsiSq => some .iPsiSqPsiSq
  | .iPsiSqPsi, .psi => some .iPsiSqPsiSq
  | .psi, .iPsiSqPsi => some .iPsiSqPsiSq
  | .iPsiCube, .psiSq => some .iPsiCubePsiSq
  | .psiSq, .iPsiCube => some .iPsiCubePsiSq
  | .iPsiCubePsi, .psi => some .iPsiCubePsiSq
  | .psi, .iPsiCubePsi => some .iPsiCubePsiSq
  | .iPsiCube, .iPsiCube => some .iPsiCubeSq
  | _, _ => none

theorem homogeneity_product (κ : Kappa) {a b c : Symbol}
    (h : productSymbol a b = some c) :
    homogeneity κ c = homogeneity κ a + homogeneity κ b := by
  cases a <;> cases b <;> simp [productSymbol] at h ⊢
  all_goals subst c
  all_goals simp [homogeneity]
  all_goals ring

/-- The explicitly negative part `F₋` from Hairer, Theorem 10.22. -/
def isFMinus : Symbol → Prop
  | .noise => True
  | .psi => True
  | .psiSq => True
  | .psiCube => True
  | .psiSqX _ => True
  | .iPsiCubePsi => True
  | .iPsiSqPsiSq => True
  | .iPsiCubePsiSq => True
  | _ => False

/-- The finite set denoted `F₋` in Hairer Theorem 10.22. -/
def fMinus : Finset Symbol := by
  classical
  exact (Finset.univ : Finset Symbol).filter isFMinus

theorem mem_fMinus_iff_isFMinus (τ : Symbol) : τ ∈ fMinus ↔ isFMinus τ := by
  simp [fMinus]

theorem homogeneity_neg_iff_isFMinus (κ : Kappa) (τ : Symbol) :
    homogeneity κ τ < 0 ↔ isFMinus τ := by
  have hk : 0 < κ.1 := kappa_pos κ
  have hk₀ : κ.1 < 1 / 16 := kappa_lt_kappa₀ κ
  cases τ <;> simp [homogeneity, isFMinus]
  all_goals linarith

end RegularityStructures.Phi43

end
